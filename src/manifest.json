{
  "manifest_version": 3,
  "name": "AI Browser Risk Intelligence",
  "version": "1.0.0",
  "description": "Browser-level security extension for link risk intelligence",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "windows"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["assets/tooltip.css", "assets/panel.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model.onnx",
        "ort-wasm.wasm",
        "ort-wasm-simd.wasm",
        "ort-wasm-threaded.wasm",
        "ort-wasm-simd-threaded.wasm",
        "ort-wasm.js",
        "ort-wasm-simd.js",
        "ort-wasm-threaded.js",
        "ort-wasm-simd-threaded.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "host_permissions": []
}
